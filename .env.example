# Preferred: run `pnpm auth:hash -- "your password"` and store the output here.
PORTFOLIO_PASSWORD_HASH=scrypt:replace-with-generated-salt:replace-with-generated-hash

# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# Increment this whenever the password changes to invalidate existing cookies.
AUTH_VERSION=1

# Added automatically when a Vercel Private Blob store is connected.
BLOB_READ_WRITE_TOKEN=
